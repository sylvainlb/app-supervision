# Config front par environnement (spec §1.4/§13.6) — copier en .env (gitignoré).
# Valeurs LOCALHOST = back FAP-light lancé en compose (voir ../fap-light-serveur) :
#   cd ../fap-light-serveur && cp .env.example .env && ./scripts/deploy.sh
#   → caddy https://localhost (certificat auto-signé en local : l'accepter dans le navigateur)
#   → Keycloak https://localhost/auth/realms/fap-light (console admin : http://localhost:8080)
POD_URL=https://localhost
OIDC_ISSUER=https://localhost/auth/realms/fap-light
OIDC_CLIENT_ID=fap-light-ui

# En production : remplacer par le vrai domaine du pod, ex. :
# POD_URL=https://fap.example.com
# OIDC_ISSUER=https://fap.example.com/auth/realms/fap-light
