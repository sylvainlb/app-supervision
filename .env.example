# Front config per environment (spec §1.4/§13.6) — generated by ./scripts/configure.sh
# (do not edit .env by hand: run `./scripts/configure.sh [POD_URL]`).
#
# The client is SELF-CONTAINED from the backend server: no vite proxy, all calls go
# absolute to POD_URL (cross-origin — CORS is handled by the back, /auth by Keycloak).
#
# Local dev (back started by ../app-supervision-backend/scripts/start.sh, plain HTTP):
#   ./scripts/configure.sh                      # → POD_URL=http://localhost
#   npm run dev                                 # → http://localhost:5173
#   Keycloak login: alice / bob / admin (password `dev` in dev)
#
# Staging/prod: ./scripts/configure.sh https://fap.example.com
POD_URL=http://localhost
OIDC_ISSUER=http://localhost/auth/realms/fap-light
OIDC_CLIENT_ID=fap-light-ui
# Demo fixtures (sample data if the back does not answer): 1 = yes, 0 = no
VITE_FIXTURES=0
