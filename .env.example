# Config front par environnement (spec §1.4/§13.6) — générée par ./scripts/configure.sh
# (ne pas éditer .env à la main : lancer `./scripts/configure.sh [POD_URL]`).
#
# Le client est AUTONOME du serveur backend : aucun proxy vite, tous les appels partent
# en absolu vers POD_URL (cross-origin — le CORS est géré par le back, /auth par Keycloak).
#
# Dev local (back lancé par ../app-supervision-backend/scripts/start.sh, HTTP pur) :
#   ./scripts/configure.sh                      # → POD_URL=http://localhost
#   npm run dev                                 # → http://localhost:5173
#   login Keycloak : alice / bob / admin (mdp `dev` en dev)
#
# Staging/prod : ./scripts/configure.sh https://fap.example.com
POD_URL=http://localhost
OIDC_ISSUER=http://localhost/auth/realms/fap-light
OIDC_CLIENT_ID=fap-light-ui
# Fixtures de démo (données exemple si le back ne répond pas) : 1 = oui, 0 = non
VITE_FIXTURES=0
