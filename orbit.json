{
  "client": {
    "url": "http://localhost/",
    "oidc": {
      "issuer": "http://localhost/auth/realms/fap-light",
      "clientId": "fap-light-ui"
    }
  },
  "npm": {
    "@startinblox/core": "2.0.6",
    "@startinblox/oidc": "0.16.6",
    "@lit/task": "1.0.3",
    "lit": "3.3.3",
    "chart.js": "4.4.4"
  },
  "routes": [
    {
      "name": "dashboard",
      "path": "/",
      "roles": [
        "gestionnaire"
      ],
      "components": [
        "building-map",
        "energy-chart",
        "anomaly-list"
      ],
      "sections": [
        {
          "title": "Vue d'ensemble du parc",
          "components": [
            "kpi-summary"
          ]
        },
        {
          "title": "Carte du parc",
          "components": [
            "building-map"
          ]
        },
        {
          "title": "Consommation nette (réseau)",
          "components": [
            "energy-chart"
          ]
        },
        {
          "title": "Anomalies détectées",
          "components": [
            "anomaly-list"
          ]
        }
      ]
    },
    {
      "name": "building-detail",
      "path": "/buildings/:id",
      "roles": [
        "gestionnaire"
      ],
      "components": [
        "building-header",
        "energy-chart"
      ]
    },
    {
      "name": "anomalies",
      "path": "/anomalies",
      "roles": [
        "gestionnaire"
      ],
      "components": [
        "anomaly-list"
      ]
    },
    {
      "name": "tickets",
      "path": "/tickets",
      "roles": [
        "gestionnaire"
      ],
      "components": [
        "ticket-board"
      ]
    },
    {
      "name": "ticket-new",
      "path": "/tickets/new",
      "roles": [
        "gestionnaire"
      ],
      "components": [
        "ticket-new"
      ]
    },
    {
      "name": "ticket-detail",
      "path": "/tickets/:id",
      "roles": [
        "gestionnaire",
        "technicien"
      ],
      "components": [
        "ticket-detail"
      ]
    },
    {
      "name": "interventions",
      "path": "/interventions",
      "roles": [
        "technicien"
      ],
      "components": [
        "ticket-board",
        "ticket-detail"
      ]
    },
    {
      "name": "admin",
      "path": "/admin",
      "roles": [
        "admin"
      ],
      "components": [
        "user-admin"
      ]
    }
  ],
  "components": {
    "building-map": "components/building-map/building-map.js",
    "energy-chart": "components/energy-chart/energy-chart.js",
    "anomaly-list": "components/anomaly-list/anomaly-list.js",
    "ticket-board": "components/ticket-board/ticket-board.js",
    "ticket-detail": "components/ticket-detail/ticket-detail.js",
    "ticket-new": "components/ticket-new/ticket-new.js",
    "user-admin": "components/user-admin/user-admin.js",
    "solid-display": "@startinblox/core",
    "solid-form": "@startinblox/core",
    "solid-ac-checker": "@startinblox/core",
    "solid-router": "@startinblox/core",
    "kpi-summary": "components/kpi-summary/kpi-summary.js",
    "building-header": "components/building-header/building-header.js"
  }
}